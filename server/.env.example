# Kelajak Markazi API — copy to server/.env

PORT=3001
NODE_ENV=development

# Production / real data: DEMO_MODE=false (JWT + Postgres majburiy)
# Demo shortcuts: DEMO_MODE=true (faqat lokal test)
DEMO_MODE=false

# Seed faqat bo'sh DBga yozadi. Mavjud ma'lumotni o'chirish: FORCE_SEED=true npm run seed
# FORCE_SEED=false

CORS_ORIGIN=http://localhost:5173

# Infra (Docker Compose: docker compose up -d)
# DATABASE_URL=postgres://kelajak:kelajak@127.0.0.1:5433/kelajak
# REDIS_URL=redis://127.0.0.1:6379

# SMS: stub | eskiz | playmobile
SMS_PROVIDER=stub
# ESKIZ_EMAIL=
# ESKIZ_PASSWORD=
# PLAYMOBILE_LOGIN=
# PLAYMOBILE_PASSWORD=

# Payments — empty = sandbox (parent checkout uses /payments/sandbox/complete)
# CLICK_MERCHANT_ID=
# CLICK_SERVICE_ID=
# CLICK_SECRET_KEY=
# PAYME_MERCHANT_ID=
# PAYME_KEY=
# PAYMENT_RETURN_URL=http://localhost:5173/ota-ona

DEFAULT_DISTRICT_ID=d-qamashi
