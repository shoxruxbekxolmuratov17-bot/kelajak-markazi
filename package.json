{
  "name": "kelajak-markazi",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npx concurrently -k --raw \"npm run dev:api\" \"vite\" \"node scripts/start-mobile.mjs\"",
    "dev:all": "npx concurrently -k --raw \"npm run dev:api\" \"vite\" \"node scripts/start-mobile.mjs\"",
    "dev:tunnel": "npx concurrently -k --raw \"npm run dev:api\" \"vite\" \"node scripts/start-mobile-tunnel.mjs\"",
    "dev:lan": "npx concurrently -k --raw \"npm run dev:api\" \"vite\" \"node scripts/start-mobile.mjs\"",
    "stop": "node scripts/stop-dev.mjs",
    "dev:web": "vite",
    "dev:api": "node scripts/start-api.mjs",
    "dev:api:watch": "npm run dev --prefix server",
    "dev:api:force": "npm run start --prefix server",
    "dev:mobile": "node scripts/start-mobile.mjs",
    "dev:mobile:tunnel": "node scripts/start-mobile-tunnel.mjs",
    "setup": "npm install --prefix server && npm run seed --prefix server",
    "sync:shared": "node scripts/sync-shared.mjs",
    "sync:server": "node scripts/sync-server-data.mjs",
    "build:apk": "node scripts/build-mobile-apk.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port ${PORT:-4173}",
    "postinstall": "npm install --prefix server",
    "start": "serve dist -s -l ${PORT:-10000}",
    "start:api": "npm run start --prefix server",
    "render:build": "npm install --prefix server && npm run seed --prefix server",
    "render:build:web": "npm install && npm run build"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1",
    "recharts": "^2.15.0",
    "serve": "^14.2.4",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.5"
  }
}
